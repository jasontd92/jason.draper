---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShaderBackground from '../components/ShaderBackground.tsx';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Absolute canonical URL. Defaults to this page on the production site. */
  canonicalUrl?: string;
  /** OpenGraph type — "website" (default) or "article". */
  ogType?: 'website' | 'article';
  /** Background treatment: "field" (full warp) or "frame" (masked to edges,
      keeps the centre clean behind long-form text). */
  bg?: 'field' | 'frame';
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  ogType = 'website',
  bg = 'field',
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://jasondraper.ai';
const canonical =
  canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const absoluteOg = ogImage
  ? new URL(ogImage, Astro.site).href
  : undefined;

// Person schema — embedded on every page as the agentic-SEO foundation.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jason Draper',
  url: siteUrl,
  jobTitle: 'Technical Co-Founder',
  worksFor: {
    '@type': 'Organization',
    name: 'Punchcard',
    url: 'https://punchcard.com',
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Utah',
    addressCountry: 'US',
  },
  knowsAbout: [
    'AI agent orchestration',
    'LLM reliability engineering',
    'audit automation',
    'regulated-industry AI',
  ],
  sameAs: ['https://linkedin.com/in/jasontdraper'],
};
---

<!doctype html>
<!-- Root VT animation off: default cross-fade freezes a canvas snapshot and
     reads as flicker/offset even when the live shader is persisted. Content
     can still fade via transition:animate on <main>. -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Jason Draper</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jason Draper" />
    {absoluteOg && <meta property="og:image" content={absoluteOg} />}

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={absoluteOg ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOg && <meta name="twitter:image" content={absoluteOg} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jason Draper — Writing"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Person JSON-LD (present on every page) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Extra structured data (e.g. Article schema) injected per page -->
    <slot name="head" />

    <!-- Soft navigations keep the WebGL shader mounted; hard loads / no-JS
         still get a full HTML document per URL (agent + crawler friendly).
         fallback=none: no animate/swap fallback that can flash the page. -->
    <ClientRouter fallback="none" />

    <!-- No-JS safety: if Framer Motion never hydrates, keep reveal content
         fully visible instead of stuck at its hidden initial state. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <!-- Persisted across ClientRouter swaps so the WebGL canvas is never
         moved/destroyed. Island below only pushes prop updates into #jd-ambient-slot. -->
    <div
      id="jd-ambient"
      class="bg-ambient"
      aria-hidden="true"
      transition:persist="jd-ambient"
    >
      <div id="jd-ambient-slot" class="bg-shader"></div>
      <div class="bg-scrim"></div>
    </div>
    <ShaderBackground
      client:only="react"
      shape="warp"
      mask={bg === 'frame' ? 'frame' : 'none'}
    />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
