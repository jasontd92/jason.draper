---
const POWERS = ["file\nfinding", "author\nfix", "merge", "answer\nreview", "resolve\nthread", "close\nissue", "change\npipeline"];
const ROLES = [
  { name: "Verify", cells: ["own", "", "", "", "", "", ""] },
  { name: "Fix", cells: ["", "own", "wall", "own", "", "wall", ""] },
  { name: "Merge gate", cells: ["", "", "own", "", "", "", ""] },
  { name: "Review judge", cells: ["", "", "", "", "own", "", ""] },
  { name: "Re-test", cells: ["", "", "", "", "", "own", ""] },
  { name: "Self-healer", cells: ["", "", "wall", "", "", "wall", "own"] },
  { name: "Human", cells: ["", "", "protect", "", "", "", ""] }
];
const ARIA = "A segregation-of-duties matrix: seven roles against seven sensitive powers. Filing findings is owned by Verify and observers; authoring a fix and answering its review by the Fix agent, which is walled out of merging and closing; merging by the merge gate, and by a human on protected paths; resolving a review thread by a separate judge; closing an issue only by a re-test; changing the pipeline only by the nightly self-healer, which is walled out of merging product or closing findings. No role holds two conflicting powers.";
---

<div class="creed-sod">
  <figure>
    <div class="scroll">
      <div class="grid" id="cd-grid" role="img" aria-label={ARIA}>
        <div class="ch"></div>
        {POWERS.map((p, i) => <div class="ch" data-p={i} tabindex="0" set:html={p.replace("\n", "<br>")} />)}
        {ROLES.map((r, ri) => (
          <Fragment>
            <div class="rh" data-r={ri} tabindex="0">{r.name}</div>
            {r.cells.map((c, ci) => (
              <div class="cell" data-p={ci} data-r={ri}>
                {c === "own" && <i class="mark-own" />}
                {c === "protect" && <i class="mark-own protect" />}
                {c === "wall" && <span class="mark-wall">✕</span>}
              </div>
            ))}
          </Fragment>
        ))}
      </div>
    </div>
    <div class="legend">
      <span><i class="sw"></i> owns it</span>
      <span><i class="sw w">✕</i> walled out</span>
    </div>
  </figure>
</div>

<style>
  .creed-sod {
    --bg-2: #0a0f12;
    --stroke: rgba(255, 255, 255, 0.13);
    --stroke-2: rgba(255, 255, 255, 0.07);
    --ink: #eef4f3;
    --muted: #93a3a1;
    --faint: #5a6a67;
    --teal: #2fd8c6;
    --gold: #c4a574;
    --wall: #e0645a;
    --sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", "Roboto Mono", Menlo, monospace;
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    margin: 2.5rem 0;
  }
  .creed-sod * { box-sizing: border-box; }
  .creed-sod figure {
    margin: 0; border: 1px solid var(--stroke); border-radius: 16px; background: var(--bg-2);
    padding: 1rem; box-shadow: 0 24px 64px -38px rgba(0,0,0,0.9);
  }
  .creed-sod .scroll { overflow-x: auto; }
  .creed-sod .grid {
    display: grid;
    grid-template-columns: minmax(8.5rem, 1.1fr) repeat(7, minmax(3.2rem, 1fr));
    min-width: 38rem;
  }
  .creed-sod .ch, .creed-sod .rh, .creed-sod .cell {
    border-right: 1px solid var(--stroke-2); border-bottom: 1px solid var(--stroke-2);
    transition: opacity .15s, background .15s;
  }
  .creed-sod .grid > :nth-child(8n) { border-right: 0; }
  .creed-sod .grid > :nth-last-child(-n+8) { border-bottom: 0; }
  .creed-sod .ch { border-bottom-color: var(--stroke); }   /* header row set apart from the body */
  .creed-sod .ch {
    padding: 0.5rem 0.3rem 0.55rem; text-align: center;
    font-family: var(--mono); font-size: 0.66rem; line-height: 1.25; color: var(--muted); letter-spacing: 0.02em;
    display: flex; align-items: flex-end; justify-content: center; user-select: none;
  }
  .creed-sod .rh { padding: 0.7rem; display: flex; align-items: center; font-size: 0.85rem; font-weight: 600; }
  .creed-sod .cell { display: grid; place-items: center; min-height: 2.9rem; }
  .creed-sod .mark-own { width: 11px; height: 11px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px rgba(47,216,198,0.12); }
  .creed-sod .mark-own.protect { background: var(--gold); box-shadow: 0 0 0 4px rgba(196,165,116,0.14); }
  .creed-sod .mark-wall { color: var(--wall); font-size: 0.9rem; font-weight: 700; opacity: 0.7; }

  .creed-sod .grid.lit .ch:not(.on), .creed-sod .grid.lit .cell:not(.on) { opacity: 0.25; }
  .creed-sod .grid.lit .rh:not(.on) { opacity: 0.4; }
  .creed-sod .ch.on { color: var(--ink); }
  .creed-sod .ch.on, .creed-sod .rh.on, .creed-sod .cell.on { background: rgba(47,216,198,0.05); }
  .creed-sod .ch[data-p], .creed-sod .rh { cursor: default; }
  .creed-sod .ch:focus-visible, .creed-sod .rh:focus-visible { outline: 2px solid var(--teal); outline-offset: -2px; }

  .creed-sod .legend { display: flex; gap: 1.1rem; margin-top: 0.85rem; font-family: var(--mono); font-size: 0.7rem; color: var(--faint); flex-wrap: wrap; }
  .creed-sod .legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .creed-sod .sw { width: 10px; height: 10px; border-radius: 50%; background: var(--teal); }
  .creed-sod .sw.w { display: inline-flex; align-items: center; justify-content: center; border-radius: 0; background: none; color: var(--wall); font-weight: 700; font-size: 0.82rem; line-height: 1; }
</style>

<script is:inline>
  (function () {
    const grid = document.getElementById("cd-grid");
    if (!grid) return;
    const cells = [...grid.querySelectorAll(".cell")];
    const chs = [...grid.querySelectorAll(".ch[data-p]")];
    const rhs = [...grid.querySelectorAll(".rh")];
    const clear = () => { grid.classList.remove("lit"); [...cells, ...chs, ...rhs].forEach((c) => c.classList.remove("on")); };
    function litCol(p) { grid.classList.add("lit"); cells.forEach((c) => c.classList.toggle("on", +c.dataset.p === p)); chs.forEach((c) => c.classList.toggle("on", +c.dataset.p === p)); rhs.forEach((c) => c.classList.remove("on")); }
    function litRow(r) { grid.classList.add("lit"); cells.forEach((c) => c.classList.toggle("on", +c.dataset.r === r)); rhs.forEach((c) => c.classList.toggle("on", +c.dataset.r === r)); chs.forEach((c) => c.classList.remove("on")); }
    chs.forEach((h) => { h.addEventListener("mouseenter", () => litCol(+h.dataset.p)); h.addEventListener("focus", () => litCol(+h.dataset.p)); });
    rhs.forEach((h) => { h.addEventListener("mouseenter", () => litRow(+h.dataset.r)); h.addEventListener("focus", () => litRow(+h.dataset.r)); });
    grid.addEventListener("mouseleave", clear);
    grid.addEventListener("focusout", (e) => { if (!grid.contains(e.relatedTarget)) clear(); });
  })();
</script>
