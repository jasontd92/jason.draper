---
interface Props {
  class?: string;
  /** Render as a different element (e.g. "article", "section"). */
  as?: keyof HTMLElementTagNameMap;
}
const { class: className, as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['glass-card', className]}>
  <slot />
</Tag>

<style>
  .glass-card {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--border-glass);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.25s ease;
  }
  .glass-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.18);
  }

  /* Graceful degradation: on devices/browsers without backdrop-filter,
     fall back to a solid translucent panel so glass never becomes
     unreadable transparent text. Also eases GPU cost on low-end devices. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-card {
      background: rgba(18, 18, 26, 0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glass-card:hover {
      transform: none;
    }
  }
</style>
