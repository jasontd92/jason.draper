---
const path = Astro.url.pathname;
const atHome = path === '/' || path === '';
---

<header class="site-header">
  <div class="inner">
    <a
      href="/"
      class:list={['brand', { on: atHome }]}
      aria-label="Home"
      aria-current={atHome ? 'page' : undefined}
    >
      <svg
        class="mark"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.75"></rect>
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.75"></rect>
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.75"></rect>
        <rect x="13.5" y="13.5" width="7" height="7" rx="1.75"></rect>
      </svg>
      <span class="brand-name">Home</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 8, 12, 0.7);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }
  .brand:hover,
  .brand.on {
    color: var(--text-primary);
  }
  .mark {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }
  .mark rect {
    stroke: currentColor;
    stroke-width: 1.5;
    fill: transparent;
  }
  .brand.on .mark rect {
    fill: currentColor;
    fill-opacity: 0.18;
  }
  /* Swap .brand-name for the site wordmark when you name it. */
  .brand-name {
    line-height: 1;
  }
  @media (max-width: 560px) {
    .inner {
      padding: 0.7rem 1.1rem;
    }
  }
</style>
