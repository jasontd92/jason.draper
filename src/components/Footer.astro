<footer class="site-footer">
  <div class="inner">
    <nav aria-label="Footer">
      <a href="/rss.xml">RSS</a>
      <a
        href="https://linkedin.com/in/jasontdraper"
        target="_blank"
        rel="noopener me">LinkedIn</a
      >
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 5rem;
    border-top: 1px solid var(--border-glass);
    background: rgba(255, 255, 255, 0.015);
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a:hover {
    color: var(--text-primary);
  }
  @media (max-width: 640px) {
    .inner {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
