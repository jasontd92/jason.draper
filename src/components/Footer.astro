---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="tag">
      Jason Draper — Technical Co-Founder @ <a
        href="https://punchcard.com"
        target="_blank"
        rel="noopener">Punchcard</a
      >
    </p>
    <nav aria-label="Footer">
      <a href="/writing">Writing</a>
      <a href="/systems">Systems</a>
      <a href="/about">About</a>
      <a href="/rss.xml">RSS</a>
      <a
        href="https://linkedin.com/in/jasontdraper"
        target="_blank"
        rel="noopener me">LinkedIn</a
      >
    </nav>
    <p class="copy">
      © {year} Jason Draper
      <span class="credit"
        >· Wallpaper by <a
          href="https://unsplash.com/photos/9XngoIpxcEo"
          target="_blank"
          rel="noopener">Jr Korpa</a
        ></span
      >
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border-glass);
    background: rgba(255, 255, 255, 0.015);
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .tag a {
    color: var(--text-primary);
  }
  .tag a:hover {
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a:hover {
    color: var(--text-primary);
  }
  .copy {
    color: var(--text-muted);
  }
  .credit {
    opacity: 0.75;
  }
  .credit a:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
