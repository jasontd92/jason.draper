---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GlassCard from '../../components/GlassCard.astro';
import Reveal from '../../components/Reveal.tsx';

// Show active systems first, then archived; stable by name within each group.
const order = { active: 0, archived: 1 } as const;
const systems = (await getCollection('systems'))
  .filter((sys) => sys.id !== 'coaudit')
  .sort(
    (a, b) =>
      order[a.data.status] - order[b.data.status] ||
      a.data.name.localeCompare(b.data.name),
  );
---

<Base
  title="Systems"
  description="Applied AI Architectures"
>
  <section class="wrap">
    <Reveal client:load>
      <header class="page-head">
        <h1>Systems</h1>
        <p>Applied AI Architectures</p>

      </header>
    </Reveal>

    {
      systems.length === 0 ? (
        <p class="empty">Details coming soon.</p>
      ) : (
        <div class="grid">
          {systems.map((sys, i) => (
            <Reveal client:visible delay={i * 0.08}>
              <a class="card-link" href={`/systems/${sys.id}`}>
                <GlassCard as="article" class="sys-card">
                  <p class="name">{sys.data.name}</p>
                  <h2>{sys.data.tagline}</h2>
                  <p class="desc">{sys.data.description}</p>
                  <span class="read">Read →</span>
                </GlassCard>
              </a>
            </Reveal>
          ))}
        </div>
      )
    }
  </section>
</Base>

<style>
  .wrap {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 5rem) 1.5rem 2rem;
  }
  .page-head h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .page-head p {
    color: var(--text-muted);
    max-width: 58ch;
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
  }
  .empty {
    color: var(--text-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .card-link {
    display: block;
    height: 100%;
  }
  .sys-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.5rem;
  }
  .sys-card h2 {
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .name {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
    flex: 1;
  }
  .read {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }
</style>
