---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.tsx';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latest = posts[0];
---

<Base
  title="Jason Draper"
  description="Technical Co-Founder at Punchcard (YC S23). Missile launch officer turned founder, building AI agents reliable enough for regulated work. Writing on LLM reliability, agent orchestration, and audit automation."
>
  <section class="launcher">
    <h1 class="sr-only">Jason Draper</h1>

    <nav class="apps" aria-label="Sections">
      <Reveal client:visible>
        <a class="app" href="/writing">
          <span class="app-icon writing">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 5h11M4 10h11M4 15h7"></path>
              <path d="M15.5 17.5l4-4 2 2-4 4H15.5v-2z"></path>
            </svg>
          </span>
          <span class="app-label">Writing</span>
        </a>
      </Reveal>

      <Reveal client:visible delay={0.07}>
        <a class="app" href="/systems">
          <span class="app-icon systems">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="8" y="8" width="8" height="8" rx="1.5"></rect>
              <path d="M10 8V5M14 8V5M10 19v-3M14 19v-3M8 10H5M8 14H5M19 10h-3M19 14h-3"></path>
            </svg>
          </span>
          <span class="app-label">Systems</span>
        </a>
      </Reveal>

      <Reveal client:visible delay={0.14}>
        <a class="app" href="/about">
          <span class="app-icon about">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="9" r="3.2"></circle>
              <path d="M6 19c0-3 2.7-5 6-5s6 2 6 5"></path>
            </svg>
          </span>
          <span class="app-label">About</span>
        </a>
      </Reveal>
    </nav>
  </section>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .launcher {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(5rem, 16vh, 10rem) 1.5rem clamp(4rem, 8vw, 6rem);
  }

  /* umbrel-style: self-contained app icons + labels, no surrounding panel */
  .apps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4rem);
  }
  .app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    width: 120px;
  }
  .app-icon {
    width: 104px;
    height: 104px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      0 14px 34px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition:
      transform 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .app-icon svg {
    width: 46px;
    height: 46px;
  }
  .app:hover .app-icon {
    transform: translateY(-6px);
    box-shadow:
      0 20px 44px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .app-icon.writing {
    background: linear-gradient(150deg, rgba(47, 216, 198, 0.95), rgba(15, 90, 100, 0.95));
  }
  .app-icon.systems {
    background: linear-gradient(150deg, rgba(42, 169, 201, 0.92), rgba(20, 55, 95, 0.95));
  }
  .app-icon.about {
    background: linear-gradient(150deg, rgba(64, 200, 180, 0.9), rgba(18, 80, 110, 0.95));
  }
  .app-label {
    font-weight: 550;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  @media (prefers-reduced-motion: reduce) {
    .app:hover .app-icon {
      transform: none;
    }
  }
</style>
